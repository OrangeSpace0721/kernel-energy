# Measurement outputs. These get large fast -- a full fleet sweep is tens of thousands
# of rows across dozens of shard files, and the HF cache under KE_ROOT is 100+ GB.
# Nothing under data/ should ever reach the repo.
data/
hf/
logs/

# SLURM job output
*.out
*.err
slurm-*.out
ke-*.out

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
build/
dist/
.venv/
venv/

# Site overrides -- keep slurm/config.sh tracked, but let a machine-specific copy
# sit beside it without being committed.
slurm/config.local.sh
.env

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
